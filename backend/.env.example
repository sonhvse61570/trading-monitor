# Copy to .env and fill in your keys.
# Get testnet keys at https://testnet.binancefuture.com
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# OKX (https://www.okx.com/trade-api) — required for OKX trading
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# Bybit (https://bybit-exchange.github.io/docs/v5/intro) — required for Bybit trading
BYBIT_API_KEY=
BYBIT_API_SECRET=

CORS_ORIGINS=http://localhost:3000

# Telegram alerts (create bot via @BotFather, get chat_id via @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Strategy scanner: symbols + how often to evaluate (seconds)
SCAN_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT
SCAN_INTERVAL_SECONDS=60

# Risk limits
MAX_DRAWDOWN_PCT=10
MAX_MARGIN_USAGE=0.8
MAX_POSITIONS=10

# Backtest cost model (taker fee % per side)
TAKER_FEE_PCT=0.05

# Optional simple auth — when set, all /api/* require "Authorization: Bearer <token>"
API_TOKEN=
